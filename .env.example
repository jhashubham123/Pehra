# Copy to .env for local use. On Vercel, add the same names in Project > Settings > Environment Variables.

# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Use the POOLER string on Vercel (the direct one does not work from serverless/IPv4).
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DB_SSL=true
DB_POOL_MAX=3

# Long random text, 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# Firebase Phone Auth token verification.
FIREBASE_PROJECT_ID=pehra-fbcbd
# For local development, save the downloaded service-account JSON in this project folder
# (the filename is git-ignored) and set its path instead of committing it.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# On Vercel, use FIREBASE_SERVICE_ACCOUNT_JSON with the full JSON credential value instead.

# Local development only: returns the generated OTP as dev_otp. Never enable in production.
OTP_PROVIDER=console
OTP_DEBUG_RETURN=true

PORT=4000
NODE_ENV=development
